# Every variable is optional. Leave a value empty to use the public default.
# Real values go in .env.local (local) or the Vercel dashboard, never in this file.

# Robinhood Chain RPC for server reads (e.g. an Alchemy endpoint). Empty = public RPC + publicnode/drpc fallbacks.
ROBINHOOD_RPC_URL=
# RPC the browser may call directly. It is public: never put a secret key here. Empty = public RPC.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
# WalletConnect / Reown project id (32 hex, dashboard.reown.com). Empty = "Not configured on this site yet" in the dialog.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
